<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Feverfew\SignatureCheck.cs" Link="SignatureCheck.cs" />
    <Compile Include="..\..\src\Feverfew\Model.cs" Link="Model.cs" />
    <Compile Include="..\..\src\Feverfew\Redactor.cs" Link="Redactor.cs" />
    <Compile Include="..\..\src\Feverfew\Collectors\FastStartupResume.cs" Link="Collectors\FastStartupResume.cs" />
    <Compile Include="..\..\src\Feverfew\Collectors\AmdWritesVerdict.cs" Link="Collectors\AmdWritesVerdict.cs" />
    <Compile Include="..\..\src\Feverfew\Collectors\MemorySlots.cs" Link="Collectors\MemorySlots.cs" />
    <Compile Include="..\..\src\Feverfew\Collectors\DriveWrites.cs" Link="Collectors\DriveWrites.cs" />
    <None Include="..\..\src\Feverfew\Trust\*.cer" Link="Trust\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
